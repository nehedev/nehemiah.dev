          </a>

          <a href="https://github.com/nehedev" target="_blank" rel="noopener" class="contact-item">
            <span class="contact-icon">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/>
              </svg>
            </span>
            <span>github.com/nehemiah-dev</span>
          </a>
        </div>
      </div>
      <div class="contact-cta">
        <div class="cta-card">
          <p class="cta-label mono">currently</p>
          <p class="cta-status">Open to opportunities</p>
          <p class="cta-note"></p>
          <a href="mailto:nehemiahadoba@gmail.com" class="btn btn-primary" style="margin-top:1.25rem;width:100%;justify-content:center;">
            Send me a message
          </a>
          <a href="https://docs.google.com/document/d/1bTThaR4jaNia66k7IolUhw4VDscikywQ/edit?usp=sharing&ouid=112265641191787577637&rtpof=true&sd=true" download class="btn btn-outline" style="margin-top:0.6rem;width:100%;justify-content:center;">
            View Résumé
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 4rem;
    align-items: start;
    margin-top: 2rem;
  }
  .contact-sub {
    font-size: 0.975rem;
    color: var(--text-secondary);
    margin: 1rem 0 2rem;
    line-height: 1.75;
  }
  .contact-links { display: flex; flex-direction: column; gap: 1rem; }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: color 0.15s;
  }
  .contact-item:hover { color: var(--accent); }
  .contact-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--accent);
    flex-shrink: 0;
  }
  .cta-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .cta-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .cta-status {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .cta-status::before {
    content: '●';
    color: #28c840;
    margin-right: 7px;
    font-size: 0.6rem;
    vertical-align: middle;
  }
  .cta-note {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
