        <p class="contact-sub">

        </p>
        <div class="contact-links">
          <a href="mailto:nehemiahadoba@gmail.com" class="contact-item">
            <span class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 6-10 7L2 6"/>
              </svg>
            </span>
            <span>nehemiahadoba@gmail.com</span>
          </a>

          <a href="https://www.linkedin.com/in/nehemiah-daniel-844177231" target="_blank" rel="noopener" class="contact-item">
