---
const projects = [
  {
    title: "Intell",
    description: "AI-powered energy monitoring platform that helps Nigerian and African SMEs and solar installers track, analyze, and optimize power consumption from their existing solar and inverter systems. It turns energy data into actionable insights that help businesses improve system performance, reduce energy costs, and make better power decisions.",
    impact: "Energy",
    stack: ["TypeScript", "NestJS", "Next.js", "PostgreSQL", "Redis"],
    github: null,
    demo: "https://www.intell.ng",
  },
  {
    title: "Norma",
    description: "A real-time traffic anomaly detection engine that learns application traffic patterns and identifies behavioral drift as it occurs. It replaces static, rule-based traffic monitoring with an adaptive detection workflow that combines statistical baselines, automated threat response, progressive IP blocking, and a live monitoring dashboard, enabling systems to detect suspicious activity, respond to emerging anomalies, and monitor traffic behavior in real time.",
    impact: "Security",
    stack: ["Python", "FastAPI", "Docker", "Nginx", "Linux Iptables",],
    github: "https://github.com/nehedev/norma",
    demo: null,
  },
  {
    title: "SwiftDeploy",
    description: "A policy-driven, declarative deployment engine and CLI that uses a single YAML manifest to generate runtime configurations, orchestrate container deployments, and enforce automated safety gates. It uses Open Policy Agent (OPA) and Prometheus metrics to validate deployments and prevent unsafe application rollouts.",
    impact: "Automation",
    stack: ["Python", "Docker", "Nginx", "Open Policy Agent", "Prometheus", "Rego"],
    github: "https://github.com/nehedev/swiftdeploy",
    demo: null,
  },
  {
    title: "ObserveX",
    description: "An enterprise-grade observability platform built on the LGTM stack that unifies metrics, logs, and traces into a single reliability workflow. It replaces fragmented monitoring with a self-service framework for SLO management, DORA analytics, and automated error budget alerting, enabling engineering teams to detect regressions, measure service health, and improve software delivery with confidence.",
    impact: "Visibility",
    stack: ["Terraform", "Prometheus", "Loki", "Tempo", "Grafana", "OpenTelemetry"],
    github: "https://github.com/nehedev/observeX",
    demo: null,
  },
  
];
---
<section id="projects">
  <div class="container">
    <p class="section-label">projects</p>
    <div class="projects-grid">
      {projects.map(p => (
        <article class="project-card">
          <div class="project-header">
            <h3 class="project-title">{p.title}</h3>
            <span class="impact-badge">{p.impact}</span>
          </div>
          <p class="project-desc">{p.description}</p>
          <div class="project-footer">
            <div class="stack-chips">
              {p.stack.map(s => <span class="chip">{s}</span>)}
            </div>
            <div class="project-links">
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener" class="project-link">
                  GitHub →
                </a>
              )}
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener" class="project-link">
                  Live →
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  #projects {
    padding-top: 2rem;
  }
  h2 { margin-bottom: 0.6rem; }
  .projects-sub {
    color: var(--text-secondary);
    font-size: 0.975rem;
    margin-bottom: 2.5rem;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .project-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.15s, transform 0.15s;
  }
  .project-card:hover {
    border-color: var(--purple-400);
    transform: translateY(-2px);
  }
  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .project-title {
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }
  .impact-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    white-space: nowrap;
    padding: 3px 9px;
    border-radius: 20px;
    background: var(--accent-light);
    color: var(--purple-800);
    border: 1px solid var(--purple-100);
    flex-shrink: 0;
  }
  .project-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    flex: 1;
  }
  .project-footer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .stack-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .project-links { display: flex; gap: 1rem; }
  .project-link {
    font-size: 0.8rem;
    font-family: var(--font-mono);
    color: var(--accent);
    transition: opacity 0.15s;
  }
  .project-link:hover { opacity: 0.7; }
</style>
